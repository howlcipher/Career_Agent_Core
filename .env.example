# Copy to .env and fill in your values. NEVER commit .env itself.

# ── LLM provider ─────────────────────────────────────────────────────
# ollama (default, local, free) | claude | gemini
LLM_PROVIDER="ollama"

# Ollama (local) — models used by the agent.
# Defaults if unset: llama3.1 / llava / nomic-embed-text (fits ~8-16 GB RAM).
# Recommended on 32 GB RAM machines (better writing, ~5s scoring on CPU):
OLLAMA_MODEL="qwen3:30b-instruct"
# Optional (improvements.md #24): a smaller, faster text model used ONLY for
# job fit-scoring, which is the pipeline's dominant per-job cost (measured live
# at ~9m49s of a ~10m cycle). Form mapping and validation-error solving stay on
# OLLAMA_MODEL regardless -- they pick real selectors and answer real screening
# questions, so they are not safe to downgrade. Leave unset to run every text
# call on OLLAMA_MODEL, exactly as before this option existed.
# Validate before trusting it: compare scores from both models over the same
# jobs, especially around the <50 skip threshold, since scoring decides whether
# an application is sent at all.
# OLLAMA_FAST_MODEL="qwen3:8b-instruct"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# OLLAMA_HOST="http://localhost:11434"
# Per-request timeout in minutes (default 45). A full resume+cover-letter+
# interview-prep generation on CPU-only hardware can take 25-35+ minutes at
# a ~4000-token prompt; raise this further on slower machines.
# OLLAMA_TIMEOUT_MINUTES="45"

# Career-profile markdown used for grounded RAG context. Optional when either
# USER_PROFILE.md exists in this repository or the standard sibling checkout
# ../ai_knowledge_library/USER_PROFILE.md exists. Relative paths resolve from
# the Career Agent Core repository root.
# CAREER_PROFILE_PATH="../ai_knowledge_library/USER_PROFILE.md"

# Claude (only if LLM_PROVIDER=claude; embeddings still use Ollama)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-4-8"

# Gemini (only if LLM_PROVIDER=gemini)
# GEMINI_API_KEY="your_api_key_here"
# GEMINI_MODEL="gemini-flash-latest"

# ── Scraping & mail tracking ─────────────────────────────────────────
# Optional. When unset, RemoteOK, Hacker News, and public ATS feeds still run,
# and role/ATS search queries use the free Yahoo HTML fallback.
# SERPAPI_API_KEY="your_serpapi_key"
IMAP_SERVER="imap.gmail.com:993"
IMAP_USER="your_email@gmail.com"
IMAP_APP_PASSWORD="your_16_digit_app_password"
